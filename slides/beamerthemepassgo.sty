% beamerthemepassgo.sty -- our own Beamer theme for Monopoly Lab.
%
%   * title page      a property title deed
%   * frame titles    coloured like the current colour set
%   * footline        the 40 board squares; a token moves one lap during the talk
%   * section cards   full-slide Chance / Community Chest cards
%   * R code          Sweave input/output styled to match
%
% Commands for slide authors:
%   \boardsection{<set>}{<title>}  start a section in a colour set:
%                                  brown, lightblue, pink, orange, red,
%                                  yellow, green, darkblue
%   \chancecard{<text>}            full-slide Chance card
%   \chestcard{<text>}             full-slide Community Chest card
%
% The footline squares come from \boardtrack, which the setup chunk in
% slides.Rnw writes from data/board.csv.

\ProvidesPackage{beamerthemepassgo}

\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, calc, decorations.pathreplacing}
\RequirePackage{booktabs}
\RequirePackage{fancyvrb}
\RequirePackage[sfdefault]{roboto}  % Roboto text, Roboto Slab titles
\RequirePackage{roboto-mono}         % Roboto Mono code

% ---- Colours ---------------------------------------------------------------
% Colour sets: keep in sync with GROUP_COLOURS in R/board.R.
\definecolor{pg-brown}{HTML}{8B4513}
\definecolor{pg-lightblue}{HTML}{A6DCF5}
\definecolor{pg-pink}{HTML}{D93A96}
\definecolor{pg-orange}{HTML}{F7941D}
\definecolor{pg-red}{HTML}{ED1B24}
\definecolor{pg-yellow}{HTML}{FEF200}
\definecolor{pg-green}{HTML}{1FB25A}
\definecolor{pg-darkblue}{HTML}{0072BB}
\definecolor{pg-railroad}{HTML}{2E2E2E}
\definecolor{pg-utility}{HTML}{9C9C9C}
\definecolor{pg-other}{HTML}{DDD6C5}
% Paper and ink.
\definecolor{pg-paper}{HTML}{FBF7EE}
\definecolor{pg-ink}{HTML}{1E2430}
\definecolor{pg-muted}{HTML}{7A7468}
\colorlet{pg-accent}{pg-orange}  % changed by \boardsection

\setbeamercolor{background canvas}{bg=pg-paper}
\setbeamercolor{normal text}{fg=pg-ink}
\setbeamercolor{structure}{fg=pg-ink}
\setbeamercolor{alerted text}{fg=pg-red}
\setbeamercolor{frametitle}{fg=pg-ink}
\setbeamercolor{accent strip}{bg=pg-accent}
\setbeamercolor{block title}{fg=pg-ink, bg=pg-accent!30}
\setbeamercolor{block body}{fg=pg-ink, bg=white}

% ---- Fonts -----------------------------------------------------------------
\setbeamerfont{title}{family=\robotoslab, series=\bfseries, size=\LARGE}
\setbeamerfont{subtitle}{size=\normalsize}
\setbeamerfont{frametitle}{family=\robotoslab, series=\bfseries, size=\Large}
\setbeamerfont{block title}{series=\bfseries}

% ---- Lists, blocks, misc ---------------------------------------------------
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\textcolor{pg-accent}{\rule[0.15ex]{0.8ex}{0.8ex}}}
\setbeamertemplate{itemize subitem}{\textcolor{pg-accent}{\rule[0.3ex]{0.5ex}{0.5ex}}}
\setbeamertemplate{enumerate item}{\textcolor{pg-accent}{\bfseries\insertenumlabel.}}
\setbeamertemplate{blocks}[rounded][shadow=false]

% ---- Frame title: colour strip, section label, slab title ------------------
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth, ht=5pt, dp=0pt]{accent strip}\end{beamercolorbox}%
  \vskip0.7em
  \begin{beamercolorbox}[wd=\paperwidth, leftskip=1.1em, rightskip=1.1em]{frametitle}%
    {\normalfont\scriptsize\bfseries\color{pg-muted}\MakeUppercase{\insertsectionhead}}\par
    \vskip0.15em
    \usebeamerfont{frametitle}\insertframetitle
  \end{beamercolorbox}%
  \vskip0.2em
}

% ---- Footline: the board with a moving token -------------------------------
\newlength{\pg@cell}
\setbeamertemplate{footline}{%
  \pgfmathsetlength{\pg@cell}{\paperwidth/40}%
  \pgfmathtruncatemacro{\pg@square}%
    {round(39*(\insertframenumber-1)/max(\inserttotalframenumber-1,1))}%
  \begin{tikzpicture}[x=\pg@cell]
    \useasboundingbox (0,0) rectangle (40,0.75cm);
    \node[anchor=base west, font=\scriptsize, text=pg-muted] at (0.5,0.38cm)
      {\insertshortauthor\quad\insertshorttitle};
    \node[anchor=base east, font=\scriptsize, text=pg-muted] at (39.5,0.38cm)
      {\insertframenumber\,/\,\inserttotalframenumber};
    \ifdefined\boardtrack
      \foreach \c [count=\i from 0] in \boardtrack
        \fill[pg-\c] (\i+0.05,0) rectangle (\i+0.95,0.2cm);
    \fi
    \fill[pg-ink] (\pg@square+0.5,0.1cm) circle (0.14cm);
    \fill[white] (\pg@square+0.5,0.1cm) circle (0.05cm);
  \end{tikzpicture}}

% ---- Title page: a title deed ----------------------------------------------
\setbeamertemplate{title page}{%
  \centering
  \begin{tikzpicture}
    \node[minimum width=10.5cm, minimum height=6.3cm, fill=white, draw=pg-ink,
          line width=0.8pt, rounded corners=3pt] (deed) {};
    \coordinate (bandNW) at ([shift={(0.25cm,-0.25cm)}]deed.north west);
    \coordinate (bandSE) at ([shift={(-0.25cm,-2.35cm)}]deed.north east);
    \fill[pg-orange] (bandNW) rectangle (bandSE);
    \draw[pg-ink, line width=0.6pt] (bandNW) rectangle (bandSE);
    \node[font=\tiny\bfseries, text=pg-ink] at ([yshift=-0.6cm]deed.north)
      {T\,I\,T\,L\,E \quad D\,E\,E\,D};
    \node[font=\usebeamerfont{title}, text=pg-ink, text width=9.5cm, align=center]
      at ([yshift=-1.5cm]deed.north) {\inserttitle};
    \node[font=\usebeamerfont{subtitle}, text=pg-ink, text width=9.5cm, align=center]
      at ([yshift=-3.2cm]deed.north) {\insertsubtitle};
    \draw[pg-other, line width=0.6pt] ([shift={(1cm,-4.15cm)}]deed.north west)
      -- ([shift={(-1cm,-4.15cm)}]deed.north east);
    \node[font=\small, text=pg-ink, text width=9.5cm, align=center]
      at ([yshift=-4.7cm]deed.north) {\insertauthor};
    \node[font=\scriptsize, text=pg-muted, text width=9.5cm, align=center]
      at ([yshift=-5.55cm]deed.north) {\insertinstitute\ \textbullet\ \insertdate};
  \end{tikzpicture}}

% ---- Sections and cards ----------------------------------------------------
\newcommand{\boardsection}[2]{\colorlet{pg-accent}{pg-#1}\section{#2}}

% #1 deck name, #2 colour, #3 watermark symbol, #4 card text
\newcommand{\pg@card}[4]{%
  \begin{frame}
    \centering\vfill
    \begin{tikzpicture}
      \node[minimum width=9.5cm, minimum height=5.2cm] (card) {};
      \fill[white, rounded corners=8pt] (card.south west) rectangle (card.north east);
      \begin{scope}
        \clip[rounded corners=8pt] (card.south west) rectangle (card.north east);
        \fill[#2] (card.north west) rectangle ([yshift=-1.2cm]card.north east);
        \node[anchor=south east, text=#2!25, inner sep=0pt,
              font=\robotoslab\bfseries\fontsize{90}{90}\selectfont]
          at ([shift={(-0.25cm,0.1cm)}]card.south east) {#3};
      \end{scope}
      \draw[pg-ink, line width=0.8pt, rounded corners=8pt]
        (card.south west) rectangle (card.north east);
      \node[font=\robotoslab\bfseries\Large, text=pg-ink]
        at ([yshift=-0.6cm]card.north) {#1};
      \node[font=\Large\itshape, text=pg-ink, text width=6.6cm, align=center]
        at ([shift={(-0.5cm,-0.55cm)}]card.center) {#4};
    \end{tikzpicture}
    \vfill
  \end{frame}}
\newcommand{\chancecard}[1]{\pg@card{CHANCE}{pg-orange}{?}{#1}}
\newcommand{\chestcard}[1]{\pg@card{COMMUNITY CHEST}{pg-lightblue}{\texteuro}{#1}}

% ---- R code from Sweave (applied after Sweave.sty is loaded) ---------------
\AtBeginDocument{%
  \DefineVerbatimEnvironment{Sinput}{Verbatim}{fontsize=\small,
    formatcom=\color{pg-ink}, frame=leftline, framerule=2.5pt,
    rulecolor=\color{pg-accent}, framesep=0.8em}%
  \DefineVerbatimEnvironment{Soutput}{Verbatim}{fontsize=\small,
    formatcom=\color{pg-muted}, frame=leftline, framerule=2.5pt,
    rulecolor=\color{pg-other}, framesep=0.8em}%
}
