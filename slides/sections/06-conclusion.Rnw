% Section 6 -- Conclusion              Owner: Task 6 (presentation lead)     ~1 min
\boardsection{red}{Conclusion}

<<end-setup, echo=FALSE>>=
# Uses pi_stay (section 3) and the tournament results (section 5).
is_street   <- board$type == "street"
cap_rank    <- board$name[is_street][order(-pi_stay[seq_len(N_SQUARES)][is_street])]
jail_share  <- sum(pi_stay[N_SQUARES + seq_len(N_JAIL_STATES)])
co_leaders  <- gsub("_", " ", setdiff(tied, "orange"))
# Counting every landing (also the stops between doubles) instead of turn ends.
land        <- landings_per_turn(board, cards)
land_top    <- names(sort(land, decreasing = TRUE))[1:2]
stopifnot("slide 'Conclusion' needs Jail and the top capital first by landings too" =
            identical(land_top, c(board$name[jail_sq], cap_rank[1])))
to_orange   <- board$pos[board$group %in% "orange"] - jail_sq
@

\begin{frame}{Conclusion}
  \vspace{0.4em}
  \textbf{Where do you land most?}\\
  In Jail: \Sexpr{pct(jail_share)}\,\% of all turns, against
  \Sexpr{100 / N_SQUARES}\,\% per square on a fair board. Among the capitals:
  \Sexpr{cap_rank[1]}, then \Sexpr{cap_rank[2]} and \Sexpr{cap_rank[3]} (almost tied).
  Why orange? It lies \Sexpr{min(to_orange)} to \Sexpr{max(to_orange)} squares
  after Jail, right where the likeliest dice totals land.
  Counting every landing, not only turn ends, gives the same top two.
  \medskip

  \textbf{Should you buy Vienna?}\\
  Yes, if you get the whole set: among the colour sets, orange ties with
  \Sexpr{paste(co_leaders, collapse = " and ")}.
  But orange \emph{alone} is not enough: the Hoarder, who buys everything,
  wins \Sexpr{pc(rp$rate[rp$player == "Hoarder"])}\,\% of games.
  \medskip

  \centering
  \begin{tikzpicture}
    \node[draw=pg-ink, fill=white, rounded corners=6pt, inner sep=6pt,
          text=pg-ink, align=center]
      {\large\itshape ``Always buy orange!''\\[0.5ex]
       \normalsize Your uncle is half right: buy orange, and everything else too.};
  \end{tikzpicture}
\end{frame}

\chancecard{Go directly to questions.\\[0.4em]
  \normalsize Do not pass GO.\\ Do not collect €200.}

