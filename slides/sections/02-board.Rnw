% Section 2 -- The board as data       Owner: Nikola (board setup)          ~1 min
% Uses `board` and `cards` from slides.Rnw. Prefix chunk labels with "board-".
\boardsection{pink}{The board}

\begin{frame}[fragile]{The board is just a data frame}
<<board-orange>>=
orange <- subset(board, group == "orange")
orange[, c("name", "country", "price", "rent_hotel")]
@
  \vfill
  Row number = board position.
  \Sexpr{nrow(board)} squares, \Sexpr{sum(!is.na(board$price))} for sale,
  \Sexpr{nrow(cards)} cards: two CSV files, checked on load.
\end{frame}

\begin{frame}{22 capitals, eight colour sets}
  \centering
  \begin{tabular}{llrrr}
    \toprule
    Set & Capitals & Set price & House & Top hotel rent \\
    \midrule
<<board-sets, echo=FALSE, results=tex>>=
streets <- board[board$type == "street", ]
for (g in unique(streets$group)) {
  s <- streets[streets$group == g, ]
  row <- sprintf("%s & %s & €%d & €%d & €%d", gsub("_", " ", g),
                 paste(s$name, collapse = ", "), sum(s$price),
                 s$house_cost[1], max(s$rent_hotel))
  if (g == "orange") row <- gsub("([^&]+)", "\\\\textbf{\\1}", row)
  cat(row, "\\\\\n")
}
@
    \bottomrule
  \end{tabular}
  \vfill
  {\small The most expensive square is \Sexpr{board$name[which.max(board$price)]}.
  Fun fact: the 1999 board lists Geneva as the capital of Switzerland.}
\end{frame}
