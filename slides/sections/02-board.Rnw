% Section 2 -- The board as data       Owner: Nikola (board setup)          ~0.5 min
% Uses `board` and `cards` from slides.Rnw. Prefix chunk labels with "board-".
% One frame: the eight colour sets, which the tournaments refer back to.
\boardsection{pink}{The board}

\begin{frame}{The board in R: \Sexpr{sum(board$type == "street")} capitals in
  \Sexpr{length(unique(board$group[board$type == "street"]))} colour sets}
  \centering\small
  \begin{tabular}{llrrr}
    \toprule
    Set & Capitals & Set price & House & Top hotel rent \\
    \midrule
<<board-sets, echo=FALSE, results=tex>>=
streets <- board[board$type == "street", ]
for (g in unique(streets$group)) {
  s <- streets[streets$group == g, ]
  row <- sprintf("%s & %s & €%d & €%d & €%d", gsub("_", " ", g),
                 paste(s$name, collapse = ", "), sum(s$price),
                 s$house_cost[1], max(s$rent_hotel))
  if (g == "orange") row <- gsub("([^&]+)", "\\\\textbf{\\1}", row)
  cat(row, "\\\\\n")
}
@
    \bottomrule
  \end{tabular}
  \vfill
  {\small The board and the \Sexpr{nrow(cards)} cards are two CSV files, read into
  R as data frames. Row $i$ of \texttt{board} is square $i$, counted from GO.
  Fun fact: the 1999 board lists Geneva as the capital of Switzerland.}
\end{frame}
