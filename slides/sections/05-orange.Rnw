% Section 5 -- Is orange optimal?      Owner: Task 5 (income) + Nikola (Task 4) ~3 min
% Code: R/returns.R (Task 5), analysis/tournament.R (Task 4).
% Prefix chunk labels with "orange-".
\boardsection{orange}{Is orange optimal?}

<<orange-setup, echo=FALSE>>=
tour <- readRDS(here::here("results", "tournament.rds"))
pers_cols <- c("Orange Fanatic" = GROUP_COLOURS[["orange"]],
               "Hoarder" = "#2E2E2E", "Paris Snob" = GROUP_COLOURS[["dark_blue"]],
               "Jet-Setter" = "#9C9C9C", "Grandma" = GROUP_COLOURS[["pink"]])
rp <- tour$personalities$rates
rc <- tour$colour_war$rates
pc <- function(x) formatC(100 * x, format = "f", digits = 1)
gp <- tour$personalities$games
fan_set  <- gp$orange_by %in% "Orange Fanatic"     # fanatic got all three
hoard_set <- gp$orange_by %in% "Hoarder"
fan_win  <- gp$winner == "Orange Fanatic"
gc <- tour$colour_war$games
# Share of games in which each uncle completed his own set.
sets <- names(GROUP_COLOURS)
own  <- vapply(sets, function(s) mean(gc[[paste0(s, "_by")]] %in% s), 1)
best_other <- names(which.max(own[sets != "orange"]))

# The sentences on the slides below rest on these facts. If a rerun of
# analysis/tournament.R changes them, stop the build instead of showing
# text that contradicts the numbers.
cap  <- function(x) sub("^(.)", "\\U\\1", x, perl = TRUE)   # capitalise first letter
nice <- function(x) cap(gsub("_", " ", x))
tied <- rc$player[rc$upper >= rc$lower[1]]   # intervals overlapping the leader's
tie_text <- cap(if (length(tied) > 1) {
  paste0(paste(gsub("_", " ", head(tied, -1)), collapse = ", "), " and ",
         gsub("_", " ", tail(tied, 1)), " overlap: a tie at the top.")
} else paste0(gsub("_", " ", tied), " wins clearly."))
stopifnot(
  "slide 'Orange's edge' needs orange among the leaders" = "orange" %in% tied,
  "slide 'Orange's edge' needs orange completed most often" =
    names(which.max(own)) == "orange",
  "slide 'Orange is strong, if you get it' needs a win rate above 50%" =
    mean(fan_win[fan_set]) > 0.5
)
@

\begin{frame}{Expected income per colour set}
  \todo{rent per opponent turn and payback time per set, from $\pi$ (Task 5)}
\end{frame}

\begin{frame}{Tournament 1: all five at one table}
  \begin{columns}[c]
    \begin{column}{0.58\textwidth}
\setkeys{Gin}{width=\linewidth}
<<orange-pers, fig=TRUE, echo=FALSE, width=4.8, height=3.1>>=
plot_win_rates(rp, pers_cols, chance_level = 1 / nrow(rp))
@
    \end{column}
    \begin{column}{0.40\textwidth}
      \small
      \Sexpr{format(tour$n_games, big.mark = ",")} games, seats shuffled,
      95\,\% confidence intervals. Dashed: $1/\Sexpr{nrow(rp)}$, pure luck.
      \medskip

      The \textbf{Hoarder} wins \Sexpr{pc(rp$rate[rp$player == "Hoarder"])}\,\%.
      It even completes orange first in \Sexpr{pc(mean(hoard_set))}\,\% of games.
      \medskip

      The \textbf{Orange Fanatic} gets all three in only
      \Sexpr{pc(mean(fan_set))}\,\%, but then wins
      \Sexpr{pc(mean(fan_win[fan_set]))}\,\% of them.
      Orange is strong, \emph{if} you get it.
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{Tournament 2: colour war}
  \begin{columns}[c]
    \begin{column}{0.58\textwidth}
\setkeys{Gin}{width=\linewidth}
<<orange-war, fig=TRUE, echo=FALSE, width=4.8, height=3.3>>=
plot_win_rates(rc, GROUP_COLOURS, chance_level = 1 / nrow(rc))
@
    \end{column}
    \begin{column}{0.40\textwidth}
      \small
      Eight uncles, one colour set each: nobody fights over a city.
      \Sexpr{format(tour$n_games, big.mark = ",")} games.
      \medskip

      \Sexpr{nice(rc$player[1])}: \Sexpr{pc(rc$rate[1])}\,\%
      [\Sexpr{pc(rc$lower[1])}, \Sexpr{pc(rc$upper[1])}].\\
      \Sexpr{nice(rc$player[2])}: \Sexpr{pc(rc$rate[2])}\,\%
      [\Sexpr{pc(rc$lower[2])}, \Sexpr{pc(rc$upper[2])}].
      \medskip

      \Sexpr{tie_text}
      \medskip

      Orange's edge: it gets \emph{completed} most often,
      \Sexpr{pc(own[["orange"]])}\,\% of games
      (next: \Sexpr{gsub("_", " ", best_other)}, \Sexpr{pc(max(own[sets != "orange"]))}\,\%),
      because its squares are landed on most.
    \end{column}
  \end{columns}
\end{frame}
