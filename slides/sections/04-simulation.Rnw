% Section 4 -- Simulating full games   Owner: Nikola (Tasks 3 + 4)           ~1.5 min
% Code: R/game.R, R/strategies.R. Load saved results with
% readRDS(here::here("results", ...)); never run long simulations in the slides.
% Prefix chunk labels with "sim-".
\boardsection{green}{Simulation}

<<sim-setup, echo=FALSE>>=
tour <- readRDS(here::here("results", "tournament.rds"))
n_pers <- length(personalities(board))
n_sets <- length(set_fanatics(board))
@

\chestcard{Bank error in your favour.\\[0.4em]
  \normalsize Simulate \Sexpr{format(2 * tour$n_games, big.mark = "\\,")} games for free.}

\begin{frame}{Monopoly lite: the rules we simulate}
  \small
  Each game has \Sexpr{n_pers} players (tournament 1) or \Sexpr{n_sets} players
  (tournament 2), and everyone starts on GO with €\Sexpr{RULES$starting_cash}.
  \smallskip
  \begin{columns}[T]
    \begin{column}{0.48\textwidth}
      \textbf{We keep}
      \begin{itemize}\setlength{\itemsep}{0.1ex}
        \item buying cities, airports and utilities
        \item rent, doubled on a full colour set without houses
        \item houses and hotels, built evenly
        \item all \Sexpr{nrow(cards)} cards, doubles and Jail
        \item bankruptcy: cash and property go to whoever
              is owed (a player or the bank)
      \end{itemize}
    \end{column}
    \begin{column}{0.48\textwidth}
      \textbf{We drop}
      \begin{itemize}\setlength{\itemsep}{0.1ex}
        \item trading and auctions
        \item mortgages: short of cash, you sell houses at half price
        \item the limit on the number of houses
      \end{itemize}
      \smallskip
      \textbf{Who wins}
      \begin{itemize}\setlength{\itemsep}{0.1ex}
        \item the last player who is not bankrupt
        \item after \Sexpr{tour$max_rounds} rounds of turns: the highest net
              worth (cash + property and buildings at cost)
      \end{itemize}
    \end{column}
  \end{columns}
\end{frame}

\begin{frame}{Meet the players}
  \centering
  \begin{tabular}{lll}
    \toprule
    Player & Buys & Cash reserve \\
    \midrule
<<sim-players, echo=FALSE, results=tex>>=
buys <- c("Orange Fanatic" = "Stockholm, Vienna, Lisbon only",
          "Hoarder"        = "everything it lands on",
          "Paris Snob"     = "Berlin and Paris only",
          "Jet-Setter"     = "the four airports only",
          "Grandma"        = "nothing, collects €200 and knits")
for (p in personalities(board)) {
  cat(sprintf("%s & %s & €%d \\\\\n", p$name, buys[[p$name]], p$reserve))
}
@
    \bottomrule
  \end{tabular}
  \vfill
  {\small The cash reserve is money a player never spends on buying or building.
  Everyone builds houses on every full set as soon as the reserve allows,
  and pays to leave Jail at once.}
\end{frame}

\begin{frame}[fragile]{One game in R}
<<sim-one-game>>=
set.seed(69)
players <- personalities(board)
res <- play_game(board, cards, players)
res$name; res$rounds; res$ended
@
  \vfill
  {\small Each player is a list: a function \texttt{buy()} that says yes or no
   to a city, the cash reserve, and the jail rule.
   \texttt{play\_game()} returns the winner, the number of rounds and how the
   game ended.}
\end{frame}
