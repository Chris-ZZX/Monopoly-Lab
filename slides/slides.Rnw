<<setup, echo=FALSE, results=tex>>=
source(here::here("R", "board.R"))
source(here::here("R", "plots.R"))
source(here::here("R", "markov.R"))
source(here::here("R", "game.R"))
source(here::here("R", "strategies.R"))
board <- load_board()
cards <- load_cards(board)
options(width = 60)  # so R output fits on a slide

# colours for the board in the footline
track <- ifelse(board$type == "street", gsub("_", "", board$group),
         ifelse(board$type %in% c("railroad", "utility"), board$type, "other"))
cat("\\def\\boardtrack{", paste(track, collapse = ","), "}\n", sep = "")
@

