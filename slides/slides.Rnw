\documentclass[aspectratio=169, 11pt]{beamer}
\usetheme{passgo}
\newcommand{\todo}[1]{\textcolor{pg-red}{\textbf{TODO:} #1}}

\title{Your Uncle Is Half Right: Monopoly Edition}
\subtitle{Which Monopoly square do you land on most,\\ and should you buy Vienna?}
\author[Group 8]{Nikola Meshkovski, Atharv Gudi, Zixin Zheng,\\
  Richard Takacs, Jakob Lutz, Parker Joseph Edward Ellis}
\institute{Computing, Prof.\ Kurt Hornik, WU Vienna}
\date{24 November 2026}

\begin{document}
\SweaveOpts{concordance=TRUE}

<<setup, echo=FALSE, results=tex>>=
source(here::here("R", "board.R"))
source(here::here("R", "plots.R"))
source(here::here("R", "markov.R"))
source(here::here("R", "game.R"))
source(here::here("R", "strategies.R"))
board <- load_board()
cards <- load_cards(board)
options(width = 60)  # R output that fits on a slide

# Footline track: one colour per board square, straight from board.csv.
track <- ifelse(board$type == "street", gsub("_", "", board$group),
         ifelse(board$type %in% c("railroad", "utility"), board$type, "other"))
cat("\\def\\boardtrack{", paste(track, collapse = ","), "}\n", sep = "")
@

\begin{frame}
  \titlepage
\end{frame}

\SweaveInput{sections/01-question.Rnw}
\SweaveInput{sections/02-board.Rnw}
